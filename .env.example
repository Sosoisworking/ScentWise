# Canonical site origin used for canonical tags, og:url, sitemap.xml and robots.txt.
# Leave unset on Vercel until you have a custom domain — builds fall back to the
# project's production *.vercel.app URL automatically.
# VITE_SITE_URL=https://www.example.com

# AI fragrance consultant (hidden unless this is "true").
VITE_ENABLE_CHAT=false
# Any OpenAI-compatible chat completions endpoint. Defaults to Vercel AI Gateway.
# AI_BASE_URL=https://ai-gateway.vercel.sh/v1
# AI_API_KEY=
# AI_MODEL=
